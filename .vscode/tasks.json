{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "build",
      "problemMatcher": [],
      "label": "npm: build"
    },
    {
      // 開発ホスト（spike/playground を開いた開発用ウィンドウ）を、デバッガを付けずに開く。
      // VS Code 1.144 では F5（デバッガ付き）で開くと、拡張機能のプロセスが起動直後に落ちる（終了コード 134）ため
      "label": "開発ホストを開く",
      "type": "shell",
      "command": "code --extensionDevelopmentPath=\"${workspaceFolder}\" --new-window \"${workspaceFolder}/spike/playground\"",
      "dependsOn": "npm: build",
      "problemMatcher": [],
      "presentation": { "reveal": "silent" },
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
